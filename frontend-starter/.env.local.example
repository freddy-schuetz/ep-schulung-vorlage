# Variablen des Frontend-Starters (nur Platzhalter, keine echten Werte committen).
# Beim Veröffentlichen gibt Claude die Werte beim ersten /deploy-Aufruf mit (je Zeile KEY=VALUE).
# Sie gelten nur beim ersten Aufruf.

# Adresse der n8n. Ohne Angabe gilt https://n8n.ep-reisen.app (siehe lib/n8n.ts).
NEXT_PUBLIC_N8N_BASE=https://n8n.ep-reisen.app

# Pfad deines eigenen Webhooks ohne /webhook/, mit Kürzel, zum Beispiel anna-hello.
# Ohne Pfad ruft die Seite nichts auf.
NEXT_PUBLIC_HELLO_PATH=

# KI-Chat (optional). ACHTUNG: /api/chat hat KEINEN Login (offener KI-Proxy).
# In der Schulung bleibt er aus. Ein Schlüssel gehört nie in ein NEXT_PUBLIC_-Feld.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=
