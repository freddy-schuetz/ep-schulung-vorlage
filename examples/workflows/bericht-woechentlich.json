        "mode": "raw",
        "jsonOutput": "={\n  \"quelle\": \"Beispieldaten Reiseveranstalter (erfunden)\",\n  \"zeilen\": [\n    { \"datum\": \"{{ $now.minus({ days: 7 }).toISODate() }}\", \"kanal\": \"Telefon\", \"thema\": \"Skireisen\", \"anzahl\": 6 },\n    { \"datum\": \"{{ $now.minus({ days: 7 }).toISODate() }}\", \"kanal\": \"E-Mail\", \"thema\": \"Gruppenreisen\", \"anzahl\": 4 },\n    { \"datum\": \"{{ $now.minus({ days: 6 }).toISODate() }}\", \"kanal\": \"Website\", \"thema\": \"Events\", \"anzahl\": 11 },\n    { \"datum\": \"{{ $now.minus({ days: 6 }).toISODate() }}\", \"kanal\": \"E-Mail\", \"thema\": \"Skireisen\", \"anzahl\": 5 },\n    { \"datum\": \"{{ $now.minus({ days: 5 }).toISODate() }}\", \"kanal\": \"Telefon\", \"thema\": \"Anreise\", \"anzahl\": 3 },\n    { \"datum\": \"{{ $now.minus({ days: 4 }).toISODate() }}\", \"kanal\": \"Website\", \"thema\": \"Skireisen\", \"anzahl\": 9 },\n    { \"datum\": \"{{ $now.minus({ days: 4 }).toISODate() }}\", \"kanal\": \"E-Mail\", \"thema\": \"Events\", \"anzahl\": 7 },\n    { \"datum\": \"{{ $now.minus({ days: 3 }).toISODate() }}\", \"kanal\": \"Telefon\", \"thema\": \"Gruppenreisen\", \"anzahl\": 2 },\n    { \"datum\": \"{{ $now.minus({ days: 2 }).toISODate() }}\", \"kanal\": \"Website\", \"thema\": \"Events\", \"anzahl\": 14 },\n    { \"datum\": \"{{ $now.minus({ days: 2 }).toISODate() }}\", \"kanal\": \"E-Mail\", \"thema\": \"Anreise\", \"anzahl\": 3 },\n    { \"datum\": \"{{ $now.minus({ days: 1 }).toISODate() }}\", \"kanal\": \"Telefon\", \"thema\": \"Skireisen\", \"anzahl\": 4 },\n    { \"datum\": \"{{ $now.minus({ days: 1 }).toISODate() }}\", \"kanal\": \"Website\", \"thema\": \"Skireisen\", \"anzahl\": 10 }\n  ]\n}",
        "options": {}
