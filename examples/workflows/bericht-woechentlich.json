            {
              "id": "e3000000-0000-4000-8000-000000000003",
              "name": "kanaele_text",
              "value": "={{ $json.kanaele.slice().sort((a, b) => b.sum_anzahl - a.sum_anzahl).map(k => '- ' + k.kanal + ': ' + k.sum_anzahl + ' (' + Math.round(k.sum_anzahl * 100 / $json.kanaele.reduce((s, x) => s + x.sum_anzahl, 0)) + ' %)').join('\\n') }}",
              "type": "string"
            },
            {
              "id": "e3000000-0000-4000-8000-000000000004",
              "name": "themen_text",
              "value": "={{ $json.themen.slice().sort((a, b) => b.sum_anzahl - a.sum_anzahl).map(t => '- ' + t.thema + ': ' + t.sum_anzahl + ' (' + Math.round(t.sum_anzahl * 100 / $json.themen.reduce((s, x) => s + x.sum_anzahl, 0)) + ' %)').join('\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
