              "value": "={{ $now.minus({ days: 7 }).toFormat('dd.MM.yyyy') }} bis {{ $now.minus({ days: 1 }).toFormat('dd.MM.yyyy') }}",
              "type": "string"
            },
            {
              "id": "e3000000-0000-4000-8000-000000000002",
              "name": "gesamt",
              "value": "={{ $json.kanaele.reduce((summe, k) => summe + k.sum_anzahl, 0) }}",
              "type": "number"
