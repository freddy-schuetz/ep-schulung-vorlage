      "position": [
        1240,
        380
      ]
    },
    {
      "parameters": {
        "text": "=Besprechung: {{ $json.besprechung }}\n\nNotizen:\n{{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"titel\": { \"type\": \"string\", \"description\": \"Kurzer Titel der Besprechung\" },\n    \"datum\": { \"type\": \"string\", \"description\": \"Datum der Besprechung, nur wenn im Text genannt, sonst leer\" },\n    \"zusammenfassung\": { \"type\": \"string\", \"description\": \"3 bis 5 Sätze, sachlich\" },\n    \"entscheidungen\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"aufgaben\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"aufgabe\": { \"type\": \"string\" },\n          \"verantwortlich\": { \"type\": \"string\", \"description\": \"Rolle oder Name wie im Text, sonst leer\" },\n          \"faellig_bis\": { \"type\": \"string\", \"description\": \"Termin wie im Text, sonst leer\" },\n          \"beleg\": { \"type\": \"string\", \"description\": \"Kurzes wörtliches Zitat aus den Notizen\" }\n        },\n        \"required\": [\"aufgabe\"]\n      }\n    },\n    \"offene_fragen\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n  },\n  \"required\": [\"titel\", \"zusammenfassung\", \"entscheidungen\", \"aufgaben\", \"offene_fragen\"]\n}",
        "options": {
          "systemPromptTemplate": "Du strukturierst Besprechungsnotizen eines Reiseveranstalters auf Deutsch.\nÜbernimm nur, was im Text steht. Erfinde keine Namen, Termine, Zahlen oder Zusagen.\nWenn eine Angabe fehlt, lass das Feld leer.\nRechne nichts aus und runde nichts. Zahlen übernimmst du wörtlich."
        }
      },
